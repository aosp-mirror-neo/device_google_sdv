#
# SDV Core's init .rc file with services specific to Cuttlefish.

import /system/etc/init/hw/init.ethernet.rc
import /vendor/etc/init/seriallogging.rc

service init_open_dice /system_ext/bin/init_open_dice_from_file
    class core
    disabled
    # logd is not available when init_open_dice is run, so it logs to stdio which is redirected to
    # kmesg
    stdio_to_kmsg
    # TODO: b/340489679 - probably, it should run as system
    user root
    group system
    oneshot

on post-fs && property:ro.sdv.enable_seriallogging=true
    start seriallogging
