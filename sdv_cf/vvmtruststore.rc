# Copyright 2024 Google LLC
# Mounting of the vvmtruststore partition on cuttlefish.
# Note that /dev/block/by-name/vvmtruststore is only available if the
# --vvmtruststore_path=<path_to_vvmtruststore.img> argument is passed to cvd (Cuttlefish).

# mount read-only when locked
on late-fs && property:ro.boot.sdv.boot_mode=locked
    mount ext4 /dev/block/by-name/vvmtruststore /vvmtruststore noatime nosuid nodev noexec ro
    restorecon_recursive /vvmtruststore

# mount writable when unlocked
on late-fs && property:ro.boot.sdv.boot_mode=unlocked
    mount ext4 /dev/block/by-name/vvmtruststore /vvmtruststore noatime nosuid nodev noexec rw
    restorecon_recursive /vvmtruststore
    # Service discovery runs using its own user and in the system group, and, by default,
    # /vvmtruststore is owned by root. The owner and group must be changed in unlocked mode so
    # service discovery can write the partition when provisioning the device. The ownership change
    # is persisted, so when the VM is rebooted in sdv.boot_mode locked the partition stays
    # accessible for service discovery.
    chown system system /vvmtruststore
    # Service discovery runs using its own user but it's in the system group so write permission
    # must be granted for the group (i.e. for system).
    chmod 0771 /vvmtruststore
