# Copyright 2024 Google LLC
# Mounting of the vvmtruststore partition on cuttlefish.
# Note that /dev/block/by-name/vvmtruststore is only available if the
# --vvmtruststore_path=<path_to_vvmtruststore.img> argument is passed to cvd (Cuttlefish).

# if not specified, default to not using a preprovisioned vvmtruststore
#
# Note that this property must be set by a trigger that is earlier than late-fs.
# Reason is that this property must already be defined when late-fs is triggered
# and the actions gated by it are evaluated and added to the queue.
on init
    setprop ro.sdv.preprovisioned_vvmtruststore ${ro.boot.sdv.preprovisioned_vvmtruststore:-none}

# bind-mount a preprovisioned /vvmtruststore from a location in /etc.
# A workaround for CI systems that do not support passing the
# --vvmtruststore_path parameter to cvd and/or that do not support collecting
# partition images other than the standard Android ones (system, vendor, etc)
on late-fs && property:ro.sdv.preprovisioned_vvmtruststore=etc && property:ro.boot.sdv.boot_mode=locked
    mount none /system_ext/etc/vvmtruststore/${ro.boot.sdv.instance_name} /vvmtruststore bind noatime nosuid nodev noexec ro

# The files and root directory of a preprovisioned vvmtruststore image
# still need to have their SELinux context and ownership set.
# Note that actions are executed in the order they're defined.
# So for a boot mode locked and preprovisioned VM, this action will be run
# followed by the next one, which simply mounts vvmtruststore read-only.
on late-fs && property:ro.sdv.preprovisioned_vvmtruststore=img && property:ro.boot.sdv.boot_mode=locked
    # TODO: b/389638158 - Look into removing the need for setting file ownership and mode here.
    # Mount it writtable so that we can set file ownership and mode.
    mount ext4 /dev/block/by-name/vvmtruststore /vvmtruststore noatime nosuid nodev noexec rw
    chown system system /vvmtruststore
    # Service discovery runs using its own user but it's in the system group so write permission
    # must be granted for the group (i.e. for system).
    chmod 0771 /vvmtruststore
    # Remount it as read-only
    umount /vvmtruststore
    mount ext4 /dev/block/by-name/vvmtruststore /vvmtruststore noatime nosuid nodev noexec ro

# mount read-only when locked and not preprovisioned
on late-fs && property:ro.sdv.preprovisioned_vvmtruststore=none && property:ro.boot.sdv.boot_mode=locked
    mount ext4 /dev/block/by-name/vvmtruststore /vvmtruststore noatime nosuid nodev noexec ro

# mount writable when unlocked and not preprovisioned
on late-fs && property:ro.sdv.preprovisioned_vvmtruststore=none && property:ro.boot.sdv.boot_mode=unlocked
    mount ext4 /dev/block/by-name/vvmtruststore /vvmtruststore noatime nosuid nodev noexec rw
    # TODO: b/389638158 - Look into removing the need for fixing the file ownership and mode here.
    # Service discovery runs using its own user and in the system group, and, by default,
    # /vvmtruststore is owned by root. The owner and group must be changed in unlocked mode so
    # service discovery can write the partition when provisioning the device. The ownership change
    # is persisted, so when the VM is rebooted in sdv.boot_mode locked the partition stays
    # accessible for service discovery.
    chown system system /vvmtruststore
    # Service discovery runs using its own user but it's in the system group so write permission
    # must be granted for the group (i.e. for system).
    chmod 0771 /vvmtruststore
