package {
    default_applicable_licenses: ["sdv_license"],
}

cc_defaults {
    name: "sdv_vehicle_emulator@cc_defaults",
    vendor: true,
    cflags: ["-DENABLE_VENDOR_CLUSTER_PROPERTY_FOR_TESTING"],
    defaults: [
        "FakeVehicleHardwareDefaults",
        "vhal_proxy@cc_defaults",
    ],
    static_libs: [
        "android.hardware.automotive.vehicle@2.0-libproto-native",
        "EmulatorCommConn",
        "EmulatorPipeComm",
        "EmulatorSocketComm",
        "FakeVehicleHardware",
        "VehicleHalProtos",
        "VehicleEmulator",
    ],
    shared_libs: [
        "device.generic.car.emulator-aidl-V1-ndk",
        "libvhal_proxy",
    ],
}

cc_library {
    name: "SdvVehicleEmulator",
    srcs: ["src/*.cpp"],
    local_include_dirs: ["include"],
    export_include_dirs: ["include"],
    defaults: [
        "sdv_vehicle_emulator@cc_defaults"
    ],
}

cc_binary {
    name: "android.hardware.automotive.vehicle@V1-sdv-emulator-service",
    srcs: ["sdv_emulated_vehicle_service.cpp"],
    vintf_fragments: ["sdv-vhal-emulator-service.xml"],
    init_rc: [
        "data-tunnel-service.rc",
        "sdv-vhal-emulator-service.rc"
    ],
    relative_install_path: "hw",
    defaults: [
        "sdv_vehicle_emulator@cc_defaults"
    ],
    static_libs: [
        "DefaultVehicleHal",
        "SdvVehicleEmulator",
    ],
}
