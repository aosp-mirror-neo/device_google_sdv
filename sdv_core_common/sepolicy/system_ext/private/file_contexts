# The ethernet setup script for SDV.
/(system_ext|system/system_ext)/bin/ethernet\.sh        u:object_r:sdv_ethernet_setup_exec:s0

# vsock local CID system propery setup
/system/bin/vsock_local_cid u:object_r:vsock_local_cid_exec:s0

# SDV service discovery agent
/(system_ext|system/system_ext)/bin/sdv_sd_agent        u:object_r:sdv_sd_default_exec:s0

# SDV mesh agent
/(system_ext|system/system_ext)/bin/sdv_mesh_agent      u:object_r:sdv_mesh_default_exec:s0

# SDV service rpc agent
/(system_ext|system/system_ext)/bin/rpcagent            u:object_r:sdv_rpcagent_default_exec:s0

# SDV Lifecycle manager agent
/(system_ext|system/system_ext)/bin/sdv_lifecycle_agent u:object_r:sdv_lc_default_exec:s0

# SDV Package Registry agent
/(system_ext|system/system_ext)/bin/sdv_package_registry_agent u:object_r:sdv_pr_exec:s0

# SDV Orchestrator agent
/(system_ext|system/system_ext)/bin/sdv_orchestration_agent u:object_r:sdv_orch_exec:s0

# SDV VPM agent
/(system_ext|system/system_ext)/bin/sdv_vpm_agent u:object_r:sdv_vpm_exec:s0

# SDV Lifecycle Sample
/system/bin/lifecycle_sample                            u:object_r:lifecycle_sample_exec:s0

# SDV Telemetry Service
/(system_ext|system/system_ext)/bin/sdv_telemetry_service_agent    u:object_r:sdv_telemetry_exec:s0
/data/misc/telemetry(/.*)?      u:object_r:telemetry_data_file:s0

# Devices
/dev/vsock                                              u:object_r:vsock_device:s0

# SDV SOME/IP service discovery agent
/(system_ext|system/system_ext)/bin/sdv_someip_discovery_agent             u:object_r:sdv_someip_discovery_default_exec:s0

# SDV SOME/IP rust client sample
/(system_ext|system/system_ext)/bin/client_some_ip_sdv_sample    u:object_r:sdv_someip_sample_exec:s0

# SDV Orchestration Service Sample
/(system_ext|system/system_ext)/bin/orchestration_service_test                            u:object_r:orchestration_service_test_exec:s0

# SDV Lifecycle Sample for integration tests
/(system_ext|system/system_ext)/bin/lifecycle_service_test                            u:object_r:lifecycle_service_test_exec:s0

# SDV Data Tunnel Agent
/(system_ext|system/system_ext)/bin/dt_agent        u:object_r:sdv_dt_agent_exec:s0
