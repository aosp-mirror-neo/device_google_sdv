# SOME/IP sample
type sdv_someip_sample, domain;
typeattribute sdv_someip_sample coredomain;
type sdv_someip_sample_exec, system_file_type, exec_type, file_type;

typeattribute sdv_someip_sample sdv_someip_stack_client;
# Allow the sample to use Service Discovery.
typeattribute sdv_someip_sample sdv_sd_client;

# Allow the sample to be launched from the shell, and make it transition to the `sdv_someip_sample`
# domain when launched.
domain_auto_trans(shell, sdv_someip_sample_exec, sdv_someip_sample)
allow sdv_someip_sample shell:fd use;

# Allow the domain to use Binder IPC.
binder_use(sdv_someip_sample)
