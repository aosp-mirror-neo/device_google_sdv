# SOME/IP sample
type sdv_someip_sample, domain;
typeattribute sdv_someip_sample coredomain;
type sdv_someip_sample_exec, system_file_type, exec_type, file_type;

typeattribute sdv_someip_sample sdv_someip_stack_client;
# Sample transitions to `sdv_someip_sample` domain when launched from shell
domain_auto_trans(shell, sdv_someip_sample_exec, sdv_someip_sample)

# Allow domain to use Binder IPC.
binder_use(sdv_someip_sample)
