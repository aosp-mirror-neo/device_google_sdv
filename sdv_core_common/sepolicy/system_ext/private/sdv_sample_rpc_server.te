type sdv_sample_rpc_server, domain;
typeattribute sdv_sample_rpc_server coredomain;
type sdv_sample_rpc_server_exec, system_file_type, exec_type, file_type;

init_daemon_domain(sdv_sample_rpc_server)

allow sdv_sample_rpc_server self:vsock_socket { create getopt read write getattr listen accept bind };

# TODO(b/272517270): Remove these rules. They allow to run sdv_sample_rpc_server from adb shell
# without having root permissions. It's only used for development.
domain_auto_trans(shell, sdv_sample_rpc_server_exec, sdv_sample_rpc_server)
allow sdv_sample_rpc_server shell:fd use;
allow sdv_sample_rpc_server adbd:fd use;
allow sdv_sample_rpc_server adbd:unix_stream_socket { read write };

# SDV Sample RPC Server uses binder.
binder_use(sdv_sample_rpc_server)

# Sample RPC Server calls Service Discovery.
typeattribute sdv_sample_rpc_server sdv_sd_client;

# Sample RPC Server calls RPC Agent.
typeattribute sdv_sample_rpc_server sdv_rpcagent_client;
