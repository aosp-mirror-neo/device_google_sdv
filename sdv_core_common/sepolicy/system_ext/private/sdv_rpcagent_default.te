# RPC agent is a core service and system process.
core_service(sdv_rpcagent_default)

# Allow the RPC agent to use Binder IPCs.
binder_use(sdv_rpcagent_default)

typeattribute sdv_rpcagent_default sdv_rpcagent_server;

# Allow the sample to use Service Discovery.
typeattribute sdv_rpcagent_default sdv_sd_client;

# RPC agent can create sockets.
net_domain(sdv_rpcagent_default)

# The clients of the rpc agent only call it to obtain sockets, hence, they always need these socket permissions
allow sdv_rpcagent_client sdv_rpcagent_server:tcp_socket { listen read write accept getattr shutdown getopt };
