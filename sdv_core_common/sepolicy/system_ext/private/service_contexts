google.sdv.rpc.IRpcAgent/default u:object_r:sdv_rpcagent_service:s0

# SDV Lifecycle manager agent
# It has two independent binder services, and probably no process should use both. Following the
# Principle of Least Privilege, the two interfaces are assigned with different SELinux types, and
# the  rules for them are defined independently.
# ILifecycleManager is an external interface to manage SDV services. It contains commands such as
# start, stop, etc.
google.sdv.lifecycle.ILifecycleManager/default          u:object_r:sdv_lc_manager_service:s0
# IServiceManager is an internal interface that Lifecycle manager agent and the spawned SDV services
# use to communicate.
google.sdv.lifecycle.internal.IServiceManager/default u:object_r:sdv_lc_service_manager_service:s0

# IRegistry is an interface that services use to read SDV service metadata.
google.sdv.service_bundles_registry.IRegistry u:object_r:sdv_sbr_service:s0

# SDV Lifecycle Manager binder service used in integration tests.
android.sdv.lifecycle.test.IServiceCallbackVerifier u:object_r:sdv_lc_test_service_manager_service:s0

# SDV DT IPC service
google.sdv.dt.IDataTunnelAgent/default u:object_r:sdv_dt_service:s0

# SDV Telemetry service
google.sdv.telemetry.ITelemetryService/default u:object_r:sdv_telemetry_service:s0

# SDV Configurable Publisher Registry service
google.sdv.telemetry.configurable_publisher.IConfigurablePublisherRegistry/default u:object_r:sdv_configurable_publisher_registry_service:s0

# SDV VPM binder power callback service interface.
google.sdv.vpm.IPowerStateClientApi u:object_r:sdv_vpm_agent_notification_service:s0