android.sdv.rpc.IRpcAgent u:object_r:sdv_rpcagent_service:s0

# SDV Lifecycle manager agent
# It has two independent binder services, and probably no process should use both. Following the
# Principle of Least Privilege, the two interfaces are assigned with different SELinux types, and
# the  rules for them are defined independently.
# ILifecycleManager is an external interface to manage SDV services. It contains commands such as
# start, stop, etc.
android.sdv.lifecycle.ILifecycleManager          u:object_r:sdv_lc_manager_service:s0
# IServiceManager is an internal interface that Lifecycle manager agent and the spawned SDV services
# use to communicate.
android.sdv.lifecycle.internal.IServiceManager u:object_r:sdv_lc_service_manager_service:s0

# IPackageRegistry is an interface that services use to read SDV service metadata.
android.sdv.package_registry.IPackageRegistry u:object_r:sdv_pr_service:s0

# SDV SOME/IP stack IPC interface
android.system.someip.ISomeIpStack u:object_r:sdv_someip_stack_service:s0

