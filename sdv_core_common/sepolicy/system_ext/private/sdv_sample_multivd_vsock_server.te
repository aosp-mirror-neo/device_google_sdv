type sdv_sample_multivd_vsock_server, domain;
typeattribute sdv_sample_multivd_vsock_server coredomain;
type sdv_sample_multivd_vsock_server_exec, system_file_type, exec_type, file_type;

# They allow to run sdv_sample_multivd_vsock_server from adb shell
# without having root permissions. It's only used for development.
domain_auto_trans(shell, sdv_sample_multivd_vsock_server_exec, sdv_sample_multivd_vsock_server)
allow sdv_sample_multivd_vsock_server shell:fd use;
