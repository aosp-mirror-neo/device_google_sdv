type sdv_dt_agent_default, domain;

typeattribute sdv_dt_agent_default mlstrustedsubject;
typeattribute sdv_dt_agent_default sdv_core_server;
type sdv_dt_agent_default_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(sdv_dt_agent_default)

# Data Tunnel agent can use sockets
net_domain(sdv_dt_agent_default)
allow sdv_dt_agent_default self:vsock_socket { connect create getopt read write getattr listen accept bind shutdown };

