// Copyright 2023 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_test {
    name: "sdv_keymint_test",
    srcs: ["sdv_keymint_test.rs"],
    defaults: [
        "sdv@rust_defaults",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,
    rustlibs: [
        "libbinder_rs",
        "liblog_rust",
        "android.hardware.security.rkp-V3-rust",
    ],
}

rust_test {
    name: "sdv_keystore_test",
    srcs: ["sdv_keystore_test.rs"],
    defaults: [
        "sdv@rust_defaults",
        "keymint_use_latest_hal_aidl_rust",
        "keystore2_use_latest_aidl_rust",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,
    rustlibs: [
        "libbinder_rs",
        "libkeystore2_test_utils",
    ],
}
