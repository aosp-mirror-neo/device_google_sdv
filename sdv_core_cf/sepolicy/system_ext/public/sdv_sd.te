# SDV SD client and server can use Binder IPC.
binder_call(sdv_sd_client, sdv_sd_server)
binder_call(sdv_sd_server, sdv_sd_client)

# SDV SD client can find the IPC service.
allow sdv_sd_client sdv_sd_service:service_manager find;

# SDV SD server can register the IPC service.
add_service(sdv_sd_server, sdv_sd_service)
