# SDV OemUpdater sdv_oem_partition_update_client sample
# TODO(b/384499049): Move this file_contexts to sdv_core_base.
/(product|system/product)/bin/sdv_oem_partition_update_client  u:object_r:sdv_oem_partition_update_client_exec:s0

# SDV OemUpdater metadata recovery script
# TODO(b/384499049): Move this file_contexts to sdv_core_base.
/(product|system/product)/bin/recover_oem_partition.sh         u:object_r:sdv_recover_oem_partition_exec:s0

# SDV OemUpdater Writable Partition
/oem_updates(/.*)?                                             u:object_r:oem_updates:s0

# SDV OemUpdater metadata backup partition
/oem_metadata(/.*)?                                            u:object_r:oem_metadata:s0
