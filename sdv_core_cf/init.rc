# SDV's primary init .rc file which is loaded first by the init process.

# TODO(b/267320398): because the androidboot.init_rc property is set in the BoardConfig.mk, the init
# process doesn't automatically import the init .rc files placed in the
# /{system,system_ext,vendor,odm,product}/etc/init/ directories, only the init .rc files that are
# imported in this script.

# For now, just import minidroid's init.rc script.
import /system/etc/init/hw/init.minidroid.rc

# Declare and start the SDV service discovery service.
service sdv_sd_agent /system_ext/bin/sdv_sd_agent
    class core
    disabled
    user system
    group system
on property:dev.bootcomplete=1
    start sdv_sd_agent

# Trigger a sample_service when one is provided. For instance, via the extra_bootconfig_args
# argument of launch_cvd:
# launch_cvd -extra_bootconfig_args androidboot.sdv.sample_service=<sample_service_name>
on property:dev.bootcomplete=1 && property:ro.boot.sdv.sample_service=*
     # Only triggered if ro.boot.sdv.sample_service is not none.
     start ${ro.boot.sdv.sample_service}
