# <src>                         <mnt_point>     <type>  <mnt_flags options>                                     <fs_mgr_flags>

# Non-dynamic, boot critical partitions
/dev/block/by-name/boot         /boot           emmc    defaults                                                recoveryonly,slotselect,first_stage_mount,avb=boot
/dev/block/by-name/init_boot    /init_boot      emmc    defaults                                                recoveryonly,slotselect,first_stage_mount,avb=init_boot
/dev/block/by-name/vendor_boot  /vendor_boot    emmc    defaults                                                recoveryonly,slotselect

system                          /system         ext4    noatime,ro,errors=panic                                 wait,slotselect,logical,first_stage_mount,avb=vbmeta_system

# Add all non-dynamic partitions except system, after this comment

# Based on Cuttlefish's f2fs fstab entry for userdata but with the flags for file-based and metadata
# encryption.
/dev/block/by-name/userdata     /data           f2fs    nodev,noatime,nosuid,inlinecrypt,reserve_root=32768     latemount,wait,check,quota,fscompress,checkpoint=fs,fileencryption=aes-256-xts:aes-256-hctr2:inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/metadata     /metadata       ext4    nodev,noatime,nosuid                                    wait,check,formattable,first_stage_mount
/dev/block/by-name/misc         /misc           emmc    defaults                                                defaults

# The sample parititon image mounted as /oem partition has to be passed to the
# cvd command explicitly, otherwise /dev/block/by-name/custom doesn't exist.
# Setting the `wait` option introduces a 20s boot delay as the init process
# expects the custom block device to show up.
#
# To avoid that boot delay when booting on Cuttlefish in the default
# configuration (without /oem partition), we don't set `wait` option here. This
# makes init give up immediately rather than waiting.
/dev/block/by-name/custom       /oem            f2fs    nodev,noatime,ro,nosuid                                    latemount,check,quota,fscompress

# Add all dynamic partitions except system, after this comment

system_ext                      /system_ext     ext4    noatime,ro,errors=panic                                 wait,slotselect,logical,first_stage_mount,avb=vbmeta_system
product                         /product        ext4    noatime,ro,errors=panic                                 wait,slotselect,logical,first_stage_mount,avb=vbmeta_system
vendor                          /vendor         ext4    noatime,ro,errors=panic                                 wait,slotselect,logical,first_stage_mount,avb=vbmeta
vendor_dlkm                     /vendor_dlkm    ext4    noatime,ro,errors=panic                                 wait,slotselect,logical,first_stage_mount,avb=vbmeta
