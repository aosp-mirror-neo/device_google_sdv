# Copyright 2023 Google LLC
#
# Root init.rc for sdv_core_cf.

import /system/etc/init/init.sdv_core_base.rc
import /system/etc/init/init.sdv_cf.rc
import /system/etc/init/vvmtruststore.rc

# Memory profiler daemon. Does not starts automatically on boot, only when requested.
import /system/etc/init/heapprofd.rc

import /product/etc/init/oem_partition.rc
import /vendor/etc/init/android.sdv.hardware.security.keymint-service.nonsecure.rc
import /vendor/etc/init/android.hardware.macsec.rc
import /vendor/etc/init/sdv_wpa_supplicant_macsec.rc

# Declare and start the sample SDV SOME/IP stack agent.
service sdv_someip_stack_agent /vendor/bin/sdv_someip_stack_agent
    class core
    disabled
    user system
    group system
    setenv VSOMEIP_CONFIGURATION /vendor/etc/someip/vsomeip_config.json
    setenv VSOMEIP_BASE_PATH /data/vendor/vsomeip/
on property:dev.bootcomplete=1 && property:ro.sdv.vsock_local_cid=3
    start sdv_someip_stack_agent

 # Declare and start the SDV Diagnostics agent.
service sdv_diagnostics_agent /product/bin/sdv_diagnostics_agent
    class diagnostics
    user system
    group system

# Before the lifecycle manager runs, create the service bundle data directory for the custom user
# id service bundle sample and set its owner to a custom android user (AID) product_sdv_sample_user
# created in the config.fs file. This way the lifecycle manager will assign the
# product_sdv_sample_user AID to the service bundle process when it's executed.
on early-boot
    # /data/service_bundle_data/ is already created in a previous, post-fs-data trigger.
    mkdir /data/service_bundle_data/com.sdv.google.sample.lifecycle.userid.apex 0771 system_ext_sdv_lcm system
    mkdir /data/service_bundle_data/com.sdv.google.sample.lifecycle.userid.apex/LifecycleCustomUserIdSampleServiceBundle 0700 product_sdv_sample_user system

# A realistic test setup for the sdv_uds_certs_provisioner_sample so it can be launched through
# init using the start command in root:
# adb shell start sdv_uds_certs_provisioner_sample
# Alternatively, it could be executed from the shell, but then it doesn't have the right SELinux
# domain and AID.
service sdv_uds_certs_provisioner_sample /vendor/bin/sdv_uds_certs_provisioner_sample
    class core
    disabled
    user system
    group system
    oneshot
