# Copyright 2023 Google LLC
#
# SDV's init .rc file which is used to start SDV specific services

# Retrieve local vsock cid and store it in ro.boot.vsock_local_cid
service vsock_local_cid /system/bin/vsock_local_cid ro.boot.vsock_local_cid
  class core
  user root
  group shell
  oneshot
on post-fs-data
  start vsock_local_cid

service sdv_package_registry_agent /system_ext/bin/sdv_package_registry_agent
    class core
    disabled
    user system
    group system
on property:dev.bootcomplete=1
    start sdv_package_registry_agent

# Declare and start the SDV service discovery service.
service sdv_sd_agent /system_ext/bin/sdv_sd_agent
    class core
    disabled
    user root #TODO(b/285353950): use system
    group root
    enter_namespace net /mnt/run/sd_mesh

on property:dev.bootcomplete=1
    start sdv_sd_agent

service sdv_mesh_agent /system_ext/bin/sdv_mesh_agent
    class core
    disabled
    user system
    group system
on property:dev.bootcomplete=1
    start sdv_mesh_agent

# Declare and start SDV Data Tunnel agent
# TODO: b/307953753 - Don't use the filesystem to generate notifications
# We launch the agent as shell for compatibility with PDK8 where this tool
# was started manually via adb shell; system/system is the better
# credential here, but we need to change how we obtain file descriptors for
# notifications before we can stop relying on shell permissions
service dt_agent /system_ext/bin/dt_agent /data/dt_mesh.csv
    class core
    disabled
    user shell
    group shell
on property:dev.bootcomplete=1
    start dt_agent

# Declare and start the SDV RPCagent.
service rpcagent /system_ext/bin/rpcagent
    class core
    disabled
    user system
    group system
on property:dev.bootcomplete=1
    start rpcagent


# Declare and start the SDV Lifecycle manager agent.
service sdv_lifecycle_agent /system_ext/bin/sdv_lifecycle_agent
    class core
    disabled
    user system
    group system
on property:dev.bootcomplete=1
    start sdv_lifecycle_agent

# Declare and start the SDV Telemetry service agent.
service sdv_telemetry_service_agent /system_ext/bin/sdv_telemetry_service_agent
    class core
    disabled
    user system
    group system
on property:dev.bootcomplete=1
    start sdv_telemetry_service_agent

# Declare and start the SDV SOME/IP stack agent.
service sdv_someip_stack_agent /vendor/bin/sdv_someip_stack_agent
    class core
    disabled
    user system
    group system
    setenv VSOMEIP_CONFIGURATION /vendor/etc/someip/vsomeip_config.json
    setenv VSOMEIP_BASE_PATH /data/vsomeip/
on property:dev.bootcomplete=1 && property:ro.boot.vsock_local_cid=3
    start sdv_someip_stack_agent

# Declare and start the SDV SOME/IP broker agent.
service sdv_someip_broker_agent /system_ext/bin/sdv_someip_broker_agent
    class core
    disabled
    user system
    group system
on property:dev.bootcomplete=1 && property:ro.boot.vsock_local_cid=3
    start sdv_someip_broker_agent

# Declare and start the SDV VPM agent.
service sdv_vpm_agent  /system_ext/bin/sdv_vpm_agent
    class core
    disabled
    user system
    group system
on property:dev.bootcomplete=1
    start sdv_vpm_agent

# Declare and start the SDV orchestrator agent.
service sdv_orchestration_agent /system_ext/bin/sdv_orchestration_agent
    class core
    disabled
    user system
    group system
on property:dev.bootcomplete=1
    start sdv_orchestration_agent
