// Copyright 2025 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

// Preprovisioned vvmtruststore content for /system_ext/etc
//
// To be used in test environments where properly mounting a vvmtruststore
// partition is not technically possible.
//
// Not putting Android.bp files in the leaf subdirectories in order to
// make updating them simpler. See README.md
//
// Note that basic authentication is not supported in this mode. Hence its files
// (vm_certs and vm_private) are not being installed. There's no intention in
// having it covered by automated tests.

// instance1
prebuilt_etc {
    name: "vvmtruststore_instance1_etc_uds_certs",
    src: "instance1/vvmtruststore/uds_certs",
    filename: "uds_certs",
    sub_dir: "vvmtruststore/instance1",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "vvmtruststore_instance1_etc_uds_pubs",
    src: "instance1/vvmtruststore/uds_pubs",
    filename: "uds_pubs",
    sub_dir: "vvmtruststore/instance1",
    system_ext_specific: true,
}

// instance2
prebuilt_etc {
    name: "vvmtruststore_instance2_etc_uds_certs",
    src: "instance2/vvmtruststore/uds_certs",
    filename: "uds_certs",
    sub_dir: "vvmtruststore/instance2",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "vvmtruststore_instance2_etc_uds_pubs",
    src: "instance2/vvmtruststore/uds_pubs",
    filename: "uds_pubs",
    sub_dir: "vvmtruststore/instance2",
    system_ext_specific: true,
}

// instance3
prebuilt_etc {
    name: "vvmtruststore_instance3_etc_uds_certs",
    src: "instance3/vvmtruststore/uds_certs",
    filename: "uds_certs",
    sub_dir: "vvmtruststore/instance3",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "vvmtruststore_instance3_etc_uds_pubs",
    src: "instance3/vvmtruststore/uds_pubs",
    filename: "uds_pubs",
    sub_dir: "vvmtruststore/instance3",
    system_ext_specific: true,
}

// Preprovisioned vvmtruststore images
// TODO: b/379662565 - remove own_vm_cert, vm_certs and vm_private

// instance1
android_filesystem {
    name: "vvmtruststore_preprovisioned_instance1",
    defaults: ["vvmtruststore_filesystem_defaults"],
    deps: [
        "vvmtruststore_instance1_uds_certs",
        "vvmtruststore_instance1_uds_pubs",
        "vvmtruststore_instance1_own_vm_cert",
        "vvmtruststore_instance1_vm_certs",
        "vvmtruststore_instance1_vm_private",
    ],
}

// generated by executing (the UDS matches with the one in the test SDV DICE handover):
// atest sdv_keymint_test
// adb pull /data/local/tmp/keymint_uds_pub.pem
// test_uds_certs_generator --ca-private-key-list-pem-files \
//   $ANDROID_BUILD_TOP/system/software_defined_vehicle/core_services/tools/test_uds_certs_generator/test/test_uds_ca_private_keys.pem \
//   --uds-hexes 279bf45f435dc4a141b9f186711ef9adeb6d109e378faa592806b37783e80576 \
//   --ca-private-key-list-pem-files-for-uds-pubs \
//   $ANDROID_BUILD_TOP/system/software_defined_vehicle/core_services/tools/test_uds_certs_generator/test/test_uds_ca_private_keys.pem \
//   --uds-pub-pem-files keymint_uds_pub.pem \
//   --output-uds-certs-file \
//   $ANDROID_BUILD_TOP/device/google/sdv/sdv_base/vvmtruststore_preprovisioned/instance1/vvmtruststore/uds_certs
prebuilt_root {
    name: "vvmtruststore_instance1_uds_certs",
    src: "instance1/vvmtruststore/uds_certs",
    filename: "uds_certs",
    no_full_install: true,
}

prebuilt_root {
    name: "vvmtruststore_instance1_uds_pubs",
    src: "instance1/vvmtruststore/uds_pubs",
    filename: "uds_pubs",
    no_full_install: true,
}

prebuilt_root {
    name: "vvmtruststore_instance1_own_vm_cert",
    src: "instance1/vvmtruststore/own_vm_cert",
    filename: "own_vm_cert",
    no_full_install: true,
}

prebuilt_root {
    name: "vvmtruststore_instance1_vm_certs",
    src: "instance1/vvmtruststore/vm_certs",
    filename: "vm_certs",
    no_full_install: true,
}

prebuilt_root {
    name: "vvmtruststore_instance1_vm_private",
    src: "instance1/vvmtruststore/vm_private",
    filename: "vm_private",
    no_full_install: true,
}

