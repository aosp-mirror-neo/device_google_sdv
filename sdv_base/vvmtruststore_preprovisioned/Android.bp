prebuilt_etc {
    name: "vvmtruststore_instance3_uds_pubs",
    src: "instance3/vvmtruststore/uds_pubs",
    filename: "uds_pubs",
    sub_dir: "vvmtruststore/instance3",
    system_ext_specific: true,
}
