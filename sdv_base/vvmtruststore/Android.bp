// Copyright 2025 Google LLC

prebuilt_etc {
    name: "vvmtruststore.rc",
    srcs: ["vvmtruststore.rc"],
    sub_dir: "init",
    system_ext_specific: true,
}

filegroup {
    name: "vvmtruststore_file_contexts",
    srcs: ["sepolicy/vvmtruststore/private/file_contexts"],
}

android_filesystem_defaults {
    name: "vvmtruststore_filesystem_defaults",
    // The SELinux labels in the file_contexts take this directory into account, i.e. all the paths
    // there labeling files on this partition must start with this mount_point directory.
    mount_point: "/vvmtruststore",
    partition_size: 1048576, // 1 MB
    type: "ext4",
    dists: [
        {
            targets: [
                // TODO: b/404181563 - using automotive-sdv-tests is a hack to make the vvmtruststore
                //       built on CI. Build sdv-custom-images on CI, and remove this dist target.
                "automotive-sdv-tests",
                "sdv-custom-images",
            ],
        },
        {
            // export the vvmtruststore images when we build the sdv-comms-for-ivi zip file
            targets: ["sdv-comms-for-ivi"],
            dir: "sdv-comms-for-ivi",
        },
    ],
    no_full_install: true,
    // The file_contexts file that contains the SELinux labels which are applied to the files built
    // into this image.
    // The labels in the file_contexts must contain the mount_point as the root directory.
    // Instead of directly referring to the file_contexts source file located in a subdirectory of
    // this directory, doing that through a Soong module, so this default can be used in Android.bp
    // files in different directories.
    file_contexts: ":vvmtruststore_file_contexts",
}

android_filesystem {
    name: "vvmtruststore",
    defaults: ["vvmtruststore_filesystem_defaults"],
}
