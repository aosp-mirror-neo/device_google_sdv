##########################
# Devices
#
/dev/vsock                                              u:object_r:vsock_device:s0

# The open-dice devices are exposed by the open-dice kernel driver.
# Only /dev/open-dice0 should be actually used and present.
/dev/open-dice.*         u:object_r:open_dice_device:s0

##########################
# system_ext files
#

# The ethernet setup script for SDV.
/(system_ext|system/system_ext)/bin/ethernet/ethernet(.*)\.sh        u:object_r:sdv_ethernet_setup_exec:s0

# vsock local CID system propery setup
/system/bin/vsock_local_cid u:object_r:vsock_local_cid_exec:s0

# SDV service discovery agent
/(system_ext|system/system_ext)/bin/sdv_sd_agent        u:object_r:sdv_sd_default_exec:s0


# SDV service rpc agent
/(system_ext|system/system_ext)/bin/rpcagent            u:object_r:sdv_rpcagent_default_exec:s0

# SDV Data Tunnel Agent
/(system_ext|system/system_ext)/bin/dt_agent        u:object_r:sdv_dt_agent_exec:s0

# Files in the vvmtruststore partition
/vvmtruststore(/.*)?    u:object_r:vvmtruststorefs:s0
