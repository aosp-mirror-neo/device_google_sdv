# A property ONLY used by CTS tests and the Android test framework.
system_internal_prop(sdv_cts_tests_prop)

# When not root, Tradefed uses the shell domain when accessing the device.
get_prop(shell, sdv_cts_tests_prop)

# Restrict the usage of this property only to tests.
neverallow { domain -init -shell -dumpstate } sdv_cts_tests_prop:file read;