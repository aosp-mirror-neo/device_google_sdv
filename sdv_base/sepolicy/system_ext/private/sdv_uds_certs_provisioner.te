# The sdv_uds_certs_provisioner attribute covers all the permissions required to create and modify
# the uds_certs file on the /vvmtruststore partition.

# Can read and add files in the /vvmtruststore directory.
allow sdv_uds_certs_provisioner vvmtruststorefs:dir ra_dir_perms;
# Can create and modify the uds_certs file.
allow sdv_uds_certs_provisioner uds_certs_file:file create_file_perms;
# When the uds_certs_provisioner creates the "uds_certs" file on the /vvmtruststore partition then
# this file will automatically receive the uds_certs_file type.
type_transition sdv_uds_certs_provisioner vvmtruststorefs:file uds_certs_file "uds_certs";
