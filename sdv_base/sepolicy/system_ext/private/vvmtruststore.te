# Copyright 2024 Google LLC

# Let init mount a partition in the /vvmtruststore directory
allow init vvmtruststorefs:dir mounton;
allow vvmtruststorefs labeledfs:filesystem associate;

# The type for the /vvmtruststore/uds_pubs file, which is only used by
# service discovery.
type uds_pubs_file, file_type;
