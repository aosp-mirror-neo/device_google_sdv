# Mesh agent is a core service and system process.
core_service(sdv_mesh_default)
typeattribute sdv_mesh_default sdv_mesh_server;

# Mesh agent can use sockets for Binder RPC
net_domain(sdv_mesh_default)

# Mesh agent can read the CID of the VM.
allow sdv_mesh_default vsock_device:chr_file { ioctl open read };
