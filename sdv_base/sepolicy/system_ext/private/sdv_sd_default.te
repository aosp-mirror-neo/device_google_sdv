# Copyright 2024 Google LLC

# SD agent is a core service and system process.
core_service(sdv_sd_default)
typeattribute sdv_sd_default sdv_sd_server;

# SD agent can use sockets for Binder RPC
net_domain(sdv_sd_default)
allow sdv_sd_default self:vsock_socket { connect create getopt read write getattr listen accept bind shutdown };

# SD Mesh gRPC server needs access to /proc/sys/net/core/somaxconn
allow sdv_sd_default proc_net:file { read open getattr };

# SD agent can read the CID of the VM.
allow sdv_sd_default vsock_device:chr_file { ioctl open read };

# SD agent can talk to KeyMint to get the Secure World DICE chain
# (via IRemotelyProvisionedComponent)
hal_client_domain(sdv_sd_default, hal_keymint)

# SD agent can talk to the DICE Chain Provider service in init_open_dice
allow sdv_sd_default  sdv_dice_chain_provider_service:service_manager find;
binder_call(sdv_sd_default, init_open_dice)

# SDV SD server can write the value of the property.
set_prop(sdv_sd_server, mesh_missing_vms_prop)

typeattribute sdv_sd_default sdv_mesh_provisioning_server;

# SDV Mesh Provisioning client and server can call each other using Binder IPC.
binder_call(sdv_mesh_provisioning_client, sdv_mesh_provisioning_server)
binder_call(sdv_mesh_provisioning_server, sdv_mesh_provisioning_client)

# SDV Mesh Provisioning client can find the IPC service.
allow sdv_mesh_provisioning_client sdv_mesh_provisioning_service:service_manager find;

# SDV Mesh Provisioning server can register the IPC service.
add_service(sdv_mesh_provisioning_server, sdv_mesh_provisioning_service)
