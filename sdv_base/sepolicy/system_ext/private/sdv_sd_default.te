# Copyright 2024 Google LLC

# SD agent is a core service and system process.
core_service(sdv_sd_default)
typeattribute sdv_sd_default sdv_sd_server;

# SD agent can use sockets for Binder RPC
net_domain(sdv_sd_default)
allow sdv_sd_default self:vsock_socket { connect create getopt read write getattr listen accept bind shutdown };

# SD Mesh gRPC server needs access to /proc/sys/net/core/somaxconn
allow sdv_sd_default proc_net:file { read open getattr };

# SD agent can read the CID of the VM.
allow sdv_sd_default vsock_device:chr_file { ioctl open read };

# SD agent can talk to KeyMint to get the Secure World DICE chain
# (via IRemotelyProvisionedComponent)
hal_client_domain(sdv_sd_default, hal_keymint)
