# RPC agent is a core service and system process.
core_service(sdv_rpcagent_default)

typeattribute sdv_rpcagent_default sdv_rpcagent_server;

# Allow the sample to use Service Discovery.
typeattribute sdv_rpcagent_default sdv_sd_client;
# Additionally allow Data Tunnel Agent to use Transport Support Service
allow sdv_rpcagent_default sdv_transport_support_service:service_manager find;

# RPC agent can create sockets.
net_domain(sdv_rpcagent_default)

# SDV RPC client and server can use Binder IPC.
binder_call(sdv_rpcagent_client, sdv_rpcagent_server)
binder_call(sdv_rpcagent_server, sdv_rpcagent_client)

# SDV RPC client can find the IPC service.
allow sdv_rpcagent_client sdv_rpcagent_service:service_manager find;

# SDV RPC server can register the IPC service.
add_service(sdv_rpcagent_server, sdv_rpcagent_service)

# The clients of the rpc agent only call it to obtain sockets, hence, they always need these socket permissions
allow sdv_rpcagent_client sdv_rpcagent_server:tcp_socket { listen read write accept getattr shutdown getopt setopt };

# Information from the binder services served by the agent as well as their (custom) binder dump()
# is allowed to be collected in bugreports.
dump_sdv_agent(sdv_rpcagent_default)
