type vsock_local_cid, domain;
typeattribute vsock_local_cid coredomain;
type vsock_local_cid_exec, exec_type, system_file_type, file_type;

init_daemon_domain(vsock_local_cid)

# Required to read the vsock local CID
allow vsock_local_cid vsock_device:chr_file { ioctl open read };

# system internal, because it's a "/system-owned property used only in /system"
system_internal_prop(vsock_local_cid_prop)
set_prop(vsock_local_cid, vsock_local_cid_prop)
