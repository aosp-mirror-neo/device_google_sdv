# Copyright 2024 Google LLC

type sdv_provisioning_tool, domain, coredomain;
type sdv_provisioning_tool_exec, exec_type, system_file_type, file_type;

# To showcase and test the policies defined in this file for using the SDV mesh provisioning, make
# the shell transition to the sdv_provisioning_tool domain when executing its binary.
domain_auto_trans_from_shell(sdv_provisioning_tool)

# The sdv_provisioning_tool uses Binder to call the SDV mesh provisioning service
binder_use(sdv_provisioning_tool)

# Assign all the policies requires to use the SDV mesh provisioning service
typeattribute sdv_provisioning_tool sdv_mesh_provisioning_client;

# Required for the inspect command.
allow sdv_provisioning_tool vvmtruststorefs:dir search;
allow sdv_provisioning_tool uds_pubs_file:file r_file_perms;
