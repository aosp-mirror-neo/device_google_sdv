#####################################
# domain_auto_trans_from_shell(domain)
# For testing and debugging purposes, allow executing the binary of the specified domain from
# adb shell, and set up an automatic domain transition from the shell and su domains to the
# domain passed as the argument.
define(`domain_auto_trans_from_shell', `
userdebug_or_eng(`
  domain_auto_trans(shell, $1_exec, $1)
  # Force the transition from the root shell as well (when adb runs as root, the shell has the su
  # instead of the shell domain).
  domain_auto_trans(su, $1_exec, $1)

  # These rules make standard output work when running from the shell
  allow $1 adbd:fd use;
  allow $1 shell:fd use;
  allow $1 adbd:unix_stream_socket { read write };
')
')
