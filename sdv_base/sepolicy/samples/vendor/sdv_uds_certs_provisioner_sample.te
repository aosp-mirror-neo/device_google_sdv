# A sample policy for a sample service that provisions uds_certs. This sample policy is created as
# a /vendor policy to surface any potential issues, because a /vendor policy is more restrictive in
# this case than a /product policy.

type sdv_uds_certs_provisioner_sample, domain;
type sdv_uds_certs_provisioner_sample_exec, exec_type, file_type, vendor_file_type;

# The sample binary can be triggered from init.
init_daemon_domain(sdv_uds_certs_provisioner_sample)

# Through the sdv_uds_certs_provisioner attribute, sdv_uds_certs_provisioner_sample obtains all the
# vvmtruststore related permissions required to provision the uds_certs file.
typeattribute sdv_uds_certs_provisioner_sample sdv_uds_certs_provisioner;
