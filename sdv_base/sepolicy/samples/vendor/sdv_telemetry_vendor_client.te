# Define a type for your test process's domain.
type sdv_telemetry_vendor_client, domain;

type sdv_telemetry_vendor_client_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(sdv_telemetry_vendor_client)

# Assign the telemetry client attributes to client on vendor
typeattribute sdv_telemetry_vendor_client sdv_telemetry_client;
typeattribute sdv_telemetry_vendor_client sdv_configurable_publisher_registry_client;
