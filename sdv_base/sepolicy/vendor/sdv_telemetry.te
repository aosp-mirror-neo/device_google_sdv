# Copyright 2024 Google LLC

# The SDV Telemetry agent can register the ITelemetryService Binder IPC service.
add_service(sdv_telemetry_server, sdv_telemetry_service)

# The SDV Telemetry client and agent can call each other via Binder IPC.
binder_call(sdv_telemetry_client, sdv_telemetry_server)
binder_call(sdv_telemetry_server, sdv_telemetry_client)

# The SDV Telemetry client has access to the ITelemetryService Binder IPC service.
allow sdv_telemetry_client sdv_telemetry_service:service_manager find;

# File used by telemetry service for data persistance
type telemetry_data_file, file_type, data_file_type;

# SDV Telemetry Service agent is a core service.
type sdv_telemetry, domain;
typeattribute sdv_telemetry mlstrustedsubject;
type sdv_telemetry_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(sdv_telemetry)

# Allow the sdv_telemetry domain to use Binder IPC
binder_use(sdv_telemetry);
binder_use(sdv_telemetry_client);

# SDV Telemetry Service agent can register telemetry service and configurable
# publisher registry service
typeattribute sdv_telemetry sdv_telemetry_server;
# TODO: b/343460855 Remove Configurable Publisher from base and move to ivi after RPC support is available
typeattribute sdv_telemetry sdv_configurable_publisher_registry_server;

# SDV Telemetry agent can read and write directories and files to the /data/ dir
allow sdv_telemetry telemetry_data_file:dir create_dir_perms;
allow sdv_telemetry telemetry_data_file:file create_file_perms;

# SDV Telemetry agent can find and use data tunnel service
typeattribute sdv_telemetry sdv_dt_client;

# SDV Telemetry agent calls Service Discovery.
typeattribute sdv_telemetry sdv_sd_client;

# SDV Telemetry agent calls RPC Agent.
typeattribute sdv_telemetry sdv_rpcagent_client;

# SDV Telemetry Service agent can register Configurable Publisher Registry and its Binder IPC services.
add_service(sdv_telemetry, sdv_telemetry_service)
# TODO: b/343460855 Remove Configurable Publisher from base and move to ivi after RPC support is available
add_service(sdv_telemetry, sdv_configurable_publisher_registry_service)

# Information from the binder services served by the agent as well as their (custom) binder dump()
# is allowed to be collected in bugreports.
binder_call(dumpstate, sdv_telemetry)
allow sdv_telemetry dumpstate:fd use;
allow sdv_telemetry dumpstate:fifo_file write;
