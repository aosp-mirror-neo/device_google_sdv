# TODO: b/492478476 - Move the rules related to carpowerpolicyd together with rest of the private
#                     sdv_ivi_rt_default rules. The SELinux public policies for carpowerpolicyd
#                     are in /product, forcing us to put the rules in /product as well.

# The SDV IVI RT service is a client of carpowerpolicyd and can register listeners.
carpowerpolicy_callback_domain(sdv_ivi_rt_default)
