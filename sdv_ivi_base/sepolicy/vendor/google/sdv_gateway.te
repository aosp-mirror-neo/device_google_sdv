# Copyright 2024 Google LLC

# SDV Gateway Service is a core service.
type sdv_gateway, domain;
typeattribute sdv_gateway mlstrustedsubject;
type sdv_gateway_exec, exec_type, file_type, vendor_file_type;
init_daemon_domain(sdv_gateway)

typeattribute sdv_gateway sdv_gateway_server;

# SDV Gateway can register the ISdvGateway service.
add_service(sdv_gateway_server, sdv_gateway_service)

# Allow the SDV Gateway domain to use Binder IPC
binder_use(sdv_gateway_server);

# The SDV Gateway client and agent can call each other via Binder IPC.
binder_call(sdv_gateway_client, sdv_gateway_server)
binder_call(sdv_gateway_server, sdv_gateway_client)
# The SDV Gateway client must be able to directly call Service Discovery
# via Binder IPC until after b/379062170 and b/379274496 are fixed.
binder_call(sdv_gateway_client, sdv_sd_server)
binder_call(sdv_sd_server, sdv_gateway_client)
# The SDV Gateway client has direct access to Service Discovery
# via Binder IPC service until after b/379062170 and b/379274496 are fixed.
allow sdv_gateway_client sdv_sd_service:service_manager find;

# The SDV Gateway client has access to the ISdvGateway Binder IPC service.
allow sdv_gateway_client sdv_gateway_service:service_manager find;

# The SDV Gateway server is a client for SDV Comms stack agents on IVI.
typeattribute sdv_gateway sdv_sd_client;
typeattribute sdv_gateway sdv_rpcagent_client;
typeattribute sdv_gateway sdv_dt_client;

# The SDV Gateway server is a client of the Package Manager proxy service.
typeattribute sdv_gateway packagemanagerproxy_client;

# The SDV DT client is also a SDV Gateway client on IVI because DT server runs
# in the sdv_gateway process.
# Allow SDV Gateway to use Transport Support Service
allow sdv_gateway sdv_transport_support_service:service_manager find;
# SDV DT client and server can use Binder IPC (using SDV Gateway).
binder_call(sdv_dt_client, sdv_gateway_server)
binder_call(sdv_gateway_server, sdv_dt_client)
# SDV DT client and server can find the IPC service (using SDV Gateway).
allow sdv_dt_client sdv_gateway_service:service_manager find;

allow sdv_dt_client sdv_gateway_service:fifo_file { read write };
allow sdv_dt_client sdv_gateway_service:fd use;
allow sdv_gateway_client sdv_gateway_service:fifo_file { read write };
allow sdv_gateway_client sdv_gateway_service:fd use;
allow sdv_dt_client sdv_gateway:fifo_file { read write };
allow sdv_dt_client sdv_gateway:fd use;
allow sdv_gateway_client sdv_gateway:fifo_file { read write };
allow sdv_gateway_client sdv_gateway:fd use;

# SDV Gateway Agent can use sockets
net_domain(sdv_gateway)
allow sdv_gateway self:vsock_socket { connect create getopt read write getattr listen accept bind shutdown };
