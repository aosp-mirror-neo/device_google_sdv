core_service(sdv_ivi_rt_default)

# SDV IVI RT can register the IIdentityVerifier service.
add_service(sdv_ivi_rt_default, sdv_identity_verifier_service)

# The SDV IVI RT service is a client of the Package Manager proxy service.
typeattribute sdv_ivi_rt_default packagemanagerproxy_client;
