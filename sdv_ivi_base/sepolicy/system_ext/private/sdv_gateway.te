core_service(sdv_gateway)
typeattribute sdv_gateway mlstrustedsubject;

# Allow dumpstate accessing sdv_gateway, required for CTS test
binder_call(dumpstate, sdv_gateway);

# Allow the SDV Gateway domain to use Binder IPC
binder_use(sdv_gateway);

typeattribute sdv_gateway sdv_gateway_server;

# SDV Gateway can register the ISdvGateway service.
add_service(sdv_gateway_server, sdv_gateway_service)
# SDV Gateway can register the IPrivilegedGatewayNetworking service.
add_service(sdv_gateway_server, sdv_privileged_gatewaynetworking_service)

# The SDV Gateway server uses service discovery.
typeattribute sdv_gateway sdv_sd_client;

# The SDV Gateway server uses the RPC agent.
typeattribute sdv_gateway sdv_rpcagent_client;

# The SDV Gateway uses the privileged interface of SD.
allow sdv_gateway sdv_privileged_sd_service:service_manager find;

# On IVI, the DT server runs in the sdv_gateway process.
typeattribute sdv_gateway sdv_dt_server;

# Required by the DT server: allow SDV Gateway to use Transport Support Service
allow sdv_gateway sdv_transport_support_service:service_manager find;

# Required by the DT server: SDV Gateway Agent can create sockets.
net_domain(sdv_gateway)

# The SDV Gateway server is a client of the Package Manager proxy service.
typeattribute sdv_gateway packagemanagerproxy_client;

# SDV Gateway Agent can access proc_net to read the somaxconn value of the process.
allow sdv_gateway proc_net:file { getattr open read };

# SDV Gateway Agent can read and set specific system properties.
set_prop(sdv_gateway, sdv_rpc_ethernet_ready_prop)
set_prop(sdv_gateway, sdv_rpc_ethernet_available_prop)
get_prop(sdv_gateway, sdv_ethernet_ready_prop)

# The SDV Gateway client

# SDV Gateway client can access proc_net to read the somaxconn value of the process.
allow sdv_gateway_client proc_net:file { getattr open read };
# Allow the SDV Gateway client to use Binder IPC
binder_use(sdv_gateway_client);
# The SDV Gateway client and agent can call each other via Binder IPC.
binder_call(sdv_gateway_client, sdv_gateway_server)
binder_call(sdv_gateway_server, sdv_gateway_client)
# The SDV Gateway client has access to the ISdvGateway Binder IPC service.
allow sdv_gateway_client sdv_gateway_service:service_manager find;

# The SDV Gateway clients directly call Service Discovery, except for the identity interfaces.
binder_call(sdv_gateway_client, sdv_sd_server)
binder_call(sdv_sd_server, sdv_gateway_client)
allow sdv_gateway_client sdv_sd_service:service_manager find;

# TODO: b/462005657 - Clean-up SELinux rules for DT use of memfd.
allow sdv_dt_server sdv_dt_client:memfd_file { read write map };
allow sdv_dt_client sdv_dt_server:memfd_file { read write map };
allow sdv_dt_client sdv_dt_client:memfd_file { read write map };

# The SDV Gateway client must NOT bypass the SDV Gateway.
# TODO: b/391793350 - Remove the rules if they become redundant.
neverallow sdv_gateway_client sdv_id_service:service_manager find;
