# Declare and start the SDV Telemetry service agent.
service sdv_telemetry_service_agent /system_ext/bin/sdv_ivi_telemetry_service_agent
    class core
    disabled
    user system_ext_sdv_telemetry
    group system_ext_sdv_telemetry system
on boot && property:ro.boot.sdv.telemetry.enabled=1
    start sdv_telemetry_service_agent

on post-fs-data
    # set up directory to persist metric configs for Telemetry service
    mkdir /data/telemetry 0770 system_ext_sdv_telemetry system_ext_sdv_telemetry
