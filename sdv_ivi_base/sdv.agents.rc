# Copyright 2024 Google LLC
#
# SDV-IVI's init .rc file which is used to start SDV specific services on IVI.

on early-init
    # Signal that apexd-bootstrap is ready, init_open_dice can execute. IVI is a derivative of Core
    # Android, where apexd-bootstrap is run on early-init in the primary init .rc file, which
    # executes first, before this trigger.
    setprop ro.sdv.apex.bootstrap.ready true

# Retrieve local vsock CID and store it in ro.sdv.vsock_local_cid.
service vsock_local_cid /system_ext/bin/vsock_local_cid ro.sdv.vsock_local_cid
  class core
  user root
  group shell
  oneshot
on post-fs-data
  start vsock_local_cid

# Declare the SDV service discovery service.
service sdv_sd_agent /system_ext/bin/sdv_sd_agent
    class core
    disabled
    user system_ext_sdv_sd_agent
    group system
    enter_namespace net /mnt/run/sd_mesh_ns

# Declare the SDV Gateway service. Runs the SDV Data Tunnel agent as well.
service sdv_gateway /vendor/bin/sdv_gateway
    class core
    disabled
    user vendor_sdv_ivi_gateway
    group system

# Declare the SDV RPCagent.
service rpcagent /system_ext/bin/rpcagent
    class core
    disabled
    user system_ext_sdv_rpc_agent
    group system

# Start agents that are not in the root network namespace before early HALs such as
# VHAL (late-fs).
on post-fs
    start sdv_sd_agent

# Start agents that are in the root network namespace on bootcomplete, because this
# allows them to be started after the Connectivity Service has configured the ethernet
# interfaces in the root network namespace.
# TODO (b/377317735): Once DTAgent drops its dependency on RpcAgent and is moved to its
# own network namespace, SDV Gateway can be started earlier on post-fs.
# Start the SDV Gateway process before the rpcagent because it starts the DTAgent service
# as well. SDV Gateway AIDL service will only be ready once the rpcagent is also started.
on property:dev.bootcomplete=1
    start sdv_gateway
    start rpcagent
