package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_filesystem_defaults {
    name: "oem_filesystem_defaults",
    dists: [
        {
            targets: [
                // TODO: b/404181563 - using automotive-sdv-tests is a hack to make the oem
                //       built on CI. Build sdv-custom-images on CI, and remove this dist target.
                "automotive-sdv-tests",
                "sdv-custom-images",
            ],
        },
    ],
    no_full_install: true,
}

prebuilt_root {
    name: "hello_oem_txt",
    srcs: [
        "hello_oem.txt",
    ],
    no_full_install: true,
}

android_filesystem {
    name: "oem_ab",
    defaults: ["oem_filesystem_defaults"],
    // The SELinux labels in the file_contexts take this directory into account, i.e. all the paths
    // there labeling files on this partition must start with this mount_point directory.
    mount_point: "/oem_ab",
    deps: ["hello_oem_txt"],
    // 64 MiB partition_size, minimum for f2fs
    partition_size: 67108864,
    type: "f2fs",
    // The file_contexts file that contains the SELinux labels which are applied to the files built
    // into this image.
    // The labels in the file_contexts must contain the mount_point as the root directory.
    // Instead of directly referring to the file_contexts source file located in a subdirectory of
    // this directory, doing that through a Soong module, so this default can be used in Android.bp
    // files in different directories.
    file_contexts: "sepolicy/oem_ab/private/file_contexts",
}

android_filesystem {
    name: "oem_ab_metadata",
    defaults: ["oem_filesystem_defaults"],
    // The SELinux labels in the file_contexts take this directory into account, i.e. all the paths
    // there labeling files on this partition must start with this mount_point directory.
    mount_point: "/oem_ab_metadata",
    // 1 MiB partition_size
    partition_size: 1048576,
    type: "ext4",
    // The file_contexts file that contains the SELinux labels which are applied to the files built
    // into this image.
    // The labels in the file_contexts must contain the mount_point as the root directory.
    // Instead of directly referring to the file_contexts source file located in a subdirectory of
    // this directory, doing that through a Soong module, so this default can be used in Android.bp
    // files in different directories.
    file_contexts: "sepolicy/oem_ab_metadata/private/file_contexts",
}
