# Setup the A/B slot partitioning for the /oem partition.

# The use of active and current slots is the same as defined in https://source.android.com/docs/core/ota/ab#slots.

# Define the block device associated with the A or B slots:
on property:ro.persistent_properties.ready=true
  setprop persist.sdv.oem_slot_a_device /dev/block/by-name/custom
  setprop persist.sdv.oem_slot_b_device /dev/block/by-name/custom_1
  trigger sdv_mount_oem_slot

# If the active slot is not selected, set it to A at first.
on sdv_mount_oem_slot && property:persist.sdv.active_oem_slot=""
  setprop persist.sdv.active_oem_slot a
  setprop ro.boot.sdv.current_oem_slot a
  mount f2fs ${persist.sdv.oem_slot_a_device} /oem nodev noatime nosuid errors=panic

on sdv_mount_oem_slot && property:persist.sdv.active_oem_slot=a
  setprop ro.boot.sdv.current_oem_slot a
  mount f2fs ${persist.sdv.oem_slot_a_device} /oem nodev noatime nosuid errors=panic

on sdv_mount_oem_slot && property:persist.sdv.active_oem_slot=b
  setprop ro.boot.sdv.current_oem_slot b
  mount f2fs ${persist.sdv.oem_slot_b_device} /oem nodev noatime nosuid errors=panic
