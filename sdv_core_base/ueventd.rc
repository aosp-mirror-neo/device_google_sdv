# SDV Core derivate targets can put here additional ueventd.rc files to get them imported.
import /vendor/etc/sdv_core_ueventd/

# Virtual console for logcat
/dev/hvc2                 0666   system     system

# open-dice device owned by init_open_dice
/dev/open-dice0           0660   sdv_init_open_dice  sdv_init_open_dice
