# SOME/IP Broker is a core SDV agent.
core_service(sdv_someip_broker_default);

typeattribute sdv_someip_broker_default sdv_someip_stack_client;

typeattribute sdv_someip_broker_default sdv_rpcagent_client;

typeattribute sdv_someip_broker_default sdv_sd_client;
allow sdv_someip_broker_default sdv_transport_support_service:service_manager find;

allow sdv_someip_broker_default sdv_someip_stack_server:unix_stream_socket { read write getattr shutdown getopt };

typeattribute sdv_someip_broker_default sdv_dt_client;

typeattribute sdv_someip_broker_default sdv_sbr_client;

type sdv_someip_broker_agent_dump_service, protected_service, service_manager_type;
add_service(sdv_someip_broker_default, sdv_someip_broker_agent_dump_service)

type sdv_someip_broker_agent_load_indicators_service, protected_service, service_manager_type;
add_service(sdv_someip_broker_default, sdv_someip_broker_agent_load_indicators_service)

binder_call(sdv_someip_stack_server, sdv_someip_broker_default)
allow sdv_someip_stack_server sdv_someip_broker_agent_load_indicators_service:service_manager find;

# Information from the binder services served by the agent as well as their (custom) binder dump()
# is allowed to be collected in bugreports.
dump_sdv_agent(sdv_someip_broker_default)

# someip_broker agent is crash monitored on its sdv_someip_broker_agent_dump_service interface
typeattribute sdv_someip_broker_agent_dump_service sdv_crash_monitored_service;
