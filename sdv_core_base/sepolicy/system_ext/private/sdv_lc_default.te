# Copyright 2024 Google LLC

# SDV Lifecycle agent is a core service and system process.
core_service(sdv_lc_default)
typeattribute sdv_lc_default sdv_lc_server;

# Policy rules for the client processes spawned by the sdv_lc_server.

# Required by the launchService() Binder IPC.
## For piping stdin for the spawned client process.
allow sdv_lc_process_client sdv_lc_default:fifo_file read;

# Required by the killService() Binder IPC.
allow sdv_lc_default sdv_lc_process_client:process sigkill;
allow sdv_lc_default self:process { setexec };

allow sdv_lc_default self:capability { kill };

# The Lifecycle agent and the process client spawned by it can call each other via Binder IPC.
binder_call(sdv_lc_process_client, sdv_lc_default)
binder_call(sdv_lc_default, sdv_lc_process_client)

# The processes spawned by the Lifecycle agent has access to the internal IServiceManager Binder
# service.
allow sdv_lc_process_client sdv_lc_service_manager_service:service_manager find;
