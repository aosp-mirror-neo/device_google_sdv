# SDV Lifecycle agent is a core service and system process.
core_service(sdv_lc_default)
typeattribute sdv_lc_default sdv_lc_server;

# Policy rules for the service bundle client processes spawned by the sdv_lc_server.

# Required by the launchService() Binder IPC.
## For piping stdin for the spawned client process.
allow servicebundledomain sdv_lc_default:fifo_file read;

# Required by the killService() Binder IPC.
allow sdv_lc_default servicebundledomain:process sigkill;
allow sdv_lc_default self:process { setexec };

# Allow to manipulate /data/service_bundle_data/ dirs
allow sdv_lc_default service_bundle_data:dir create_dir_perms;
allow sdv_lc_default service_bundle_data:file create_file_perms;

# Allow setting uid for service bundle processes
allow sdv_lc_default self:capability { setuid setgid chown };

allow sdv_lc_default self:capability { kill };
# Allow the sdv lifecycle agent to send signals (e.g., SIGTERM, SIGKILL) to all service bundle
# processes.
allow sdv_lc_default servicebundledomain:process signal;

# Allow the sdv lifecycle agent to change scheduling parameters.
allow sdv_lc_default self:capability sys_nice;
allow sdv_lc_default priority_service_bundle:process setsched;

# The Lifecycle agent and the service bundles spawned by it can call each other via Binder IPC.
binder_call(servicebundledomain, sdv_lc_default)
binder_call(sdv_lc_default, servicebundledomain)

# The service bundles spawned by the Lifecycle agent has access to the internal IServiceManager
# Binder service.
allow servicebundledomain sdv_lc_service_manager_service:service_manager find;

# Property that indicates the current state of lifecycle agent.
system_internal_prop(lc_state_ready_prop)
# Lifecycle agent is the only agent that can set its current state.
set_prop(sdv_lc_default, lc_state_ready_prop)

# SDV Lifecycle client and agent can call each other via Binder IPC.
binder_call(sdv_lc_client, sdv_lc_server)
binder_call(sdv_lc_server, sdv_lc_client)

# SDV Lifecycle client has access to the ILifecycleManager Binder service.
allow sdv_lc_client sdv_lc_manager_service:service_manager find;

# SDV Lifecycle agent can register its Binder IPC services.
add_service(sdv_lc_server, sdv_lc_manager_service)
add_service(sdv_lc_server, sdv_lc_service_manager_service)

# Defines the external SDV Lifecycle Binder IPC service bundle crash notification service.
type sdv_lc_crash_notification_service, protected_service, service_manager_type;

add_service(sdv_lc_default, sdv_identity_verifier_service)
add_service(sdv_lc_default, sdv_lc_crash_notification_service)

# Information from the binder services served by the agent as well as their (custom) binder dump()
# is allowed to be collected in bugreports.
dump_sdv_agent(sdv_lc_default)

# Lifecycle agent is crash monitored on its sdv_lc_manager_service interface
typeattribute sdv_lc_manager_service sdv_crash_monitored_service;

# SDV Lifecycle service can use the Service Bundles Registry.
typeattribute sdv_lc_default sdv_sbr_client;
