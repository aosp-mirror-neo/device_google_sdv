# Service Discovery (SD) agent is a power state client
typeattribute sdv_sd_default sdv_vpm_agent_notification_client;

# For veryifying the FQIN belonging to a service bundle process calling createIdentity().
allow sdv_sd_default sdv_sb_identity_service:service_manager find;
binder_call(sdv_sd_default, sdv_lc_default)
