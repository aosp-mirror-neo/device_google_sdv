# Copyright 2024 Google LLC

# Orchestrator is a core SDV agent.
core_service(sdv_orch)

# Orchestrator can call the lifecycle agent.
typeattribute sdv_orch sdv_lc_client;

# Orchestrator can call the DataTunnel SDV agent.
typeattribute sdv_orch sdv_dt_client;

# File used by orch agent to persist data
type orch_data_file, file_type, data_file_type, core_data_file_type;

# TODO: b/313827965 - Define proper deplyoment strategy for orch config
# orchestrator_config_path_prop is a system internal property
system_internal_prop(orchestrator_config_path_prop)
# Orchestrator is the only one that can read the orchestrator_config_path_prop
get_prop(sdv_orch, orchestrator_config_path_prop)
# Init can set the orchestrator_config_path_prop property
set_prop(init, orchestrator_config_path_prop)

# SDV Orch agent can read and write directories and files to the /data/orchestrator/ dir
allow sdv_orch orch_data_file:dir create_dir_perms;
allow sdv_orch orch_data_file:file create_file_perms;

# Orchestrator is a power state client
typeattribute sdv_orch sdv_vpm_agent_notification_client;

typeattribute sdv_orch sdv_sd_client;
# Orchestrator creates an RPC server for custom modes
typeattribute sdv_orch sdv_rpcagent_client;

# Orchestrator can set the orchestrator_power_boot_complete_prop
set_prop(sdv_orch, orchestrator_power_boot_complete_prop)

# Orchestrator can set the orchestrator_vehicle_boot_complete_prop
set_prop(sdv_orch, orchestrator_vehicle_boot_complete_prop)

# Orchestrator can set the orchestrator_power_state_prop and init can read it.
system_internal_prop(orchestrator_power_state_prop)
set_prop(sdv_orch, orchestrator_power_state_prop)

# Property that indicates the current state of Orchestrator.
system_internal_prop(orchestrator_state_ready_prop)
# Orchestrator is the only agent that can set its current state.
set_prop(sdv_orch, orchestrator_state_ready_prop)

# Defines SDV orch service used for dumpsys.
type sdv_orch_dump_service, protected_service, service_manager_type;
add_service(sdv_orch, sdv_orch_dump_service)
