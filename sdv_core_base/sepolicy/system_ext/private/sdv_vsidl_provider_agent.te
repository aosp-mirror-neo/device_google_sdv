# Vsidl provider SDV agent.
core_service(sdv_vsidl_provider_agent)

typeattribute sdv_vsidl_provider_agent sdv_rpcagent_client;

typeattribute sdv_vsidl_provider_agent sdv_sd_client;
allow sdv_vsidl_provider_agent sdv_transport_support_service:service_manager find;

typeattribute sdv_vsidl_provider_agent sdv_dt_client;


type sdv_vsidl_provider_agent_dump_service, protected_service, service_manager_type;
add_service(sdv_vsidl_provider_agent, sdv_vsidl_provider_agent_dump_service)

# vsidl_provider agent is crash monitored on sdv_vsidl_provider_agent_dump_service binder interface
typeattribute sdv_vsidl_provider_agent_dump_service sdv_crash_monitored_service;
