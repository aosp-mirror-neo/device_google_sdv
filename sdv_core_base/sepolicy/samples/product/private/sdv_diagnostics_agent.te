# Diagnostics SDV agent.
type sdv_diagnostics_agent, domain;
typeattribute sdv_diagnostics_agent coredomain;
typeattribute sdv_diagnostics_agent mlstrustedsubject;
type sdv_diagnostics_agent_exec, exec_type, file_type, system_file_type;
init_daemon_domain(sdv_diagnostics_agent)

binder_use(sdv_diagnostics_agent)

typeattribute sdv_diagnostics_agent sdv_rpcagent_client;

typeattribute sdv_diagnostics_agent sdv_sd_client;
allow sdv_diagnostics_agent sdv_transport_support_service:service_manager find;

typeattribute sdv_diagnostics_agent sdv_dt_client;

binder_call(sdv_diagnostics_agent, sdv_sbr)
allow sdv_diagnostics_agent sdv_sbr_service:service_manager find;

net_domain(sdv_diagnostics_agent)

type sdv_diagnostics_agent_dump_service, protected_service, service_manager_type;
add_service(sdv_diagnostics_agent, sdv_diagnostics_agent_dump_service)

# Information from the binder services served by the agent as well as their (custom) binder dump()
# is allowed to be collected in bugreports.
# WARNING: sdv_diagnostics_agent is a sample implementation for test purposes only.
# The contents of its "dump" implementation might be considered security sensitive (e.g. plain
# values of diagnostics-related data that, in theory, could even contain private keys) and
# should not be dumped in a production scenario.
binder_call(dumpstate, sdv_diagnostics_agent)
allow sdv_diagnostics_agent dumpstate:fd use;
allow sdv_diagnostics_agent dumpstate:fifo_file write;

# Diag agent is crash monitored via its sdv_diagnostics_agent_dump_service binder interface
typeattribute sdv_diagnostics_agent_dump_service sdv_crash_monitored_service;
