# A custom SELinux policy for the lifecycle test service bundle that exposes a Binder service which
# is by default not permitted for service bundles.

type test_service_bundle, domain;
typeattribute test_service_bundle coredomain;

service_bundle_domain(test_service_bundle)

# Defines the Lifecycle Manager Callback Binder IPC service (IServiceCallbackVerifier) that is used
# in the LM integration tests to check if certain calls from LM where called.
type sdv_lc_test_service_manager_service, protected_service, service_manager_type;

# Lifecycle Service Test Service can register its Binder IPC service.
add_service(test_service_bundle, sdv_lc_test_service_manager_service)
