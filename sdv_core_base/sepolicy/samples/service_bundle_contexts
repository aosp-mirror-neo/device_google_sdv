# This is an example service_bundle_contexts file that configures selected Service Bundles to have
# custom SELinux domains instead of the default untrusted_service_bundle domain.
# The service_bundle_contexts is not (yet) part of the standard Android SELinux configuration
# files, so it's kept separately and not placed among other policy files.

# These sample service bundles require a custom SELinux policy to be able to add a Binder service
# used for testing.
com.android.sdv.sample.lifecycle.LifecycleRustTestServiceBundle    u:r:test_service_bundle:s0
com.android.sdv.sample.lifecycle.LifecycleCppTestServiceBundle     u:r:test_service_bundle:s0
