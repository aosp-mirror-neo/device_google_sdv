// Copyright 2024 Google LLC

package {
    default_applicable_licenses: ["sdv_license"],
}

rust_test {
    name: "sdv_keymint_test",
    team: "trendy_team_automotive",
    srcs: ["sdv_keymint_test.rs"],
    defaults: [
        "sdv@rust_defaults",
        "keymint_use_latest_hal_aidl_rust",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    auto_gen_config: true,
    rustlibs: [
        "android.hardware.security.rkp-V3-rust",
        "libanyhow",
        "libbinder_rs",
        "libhwtrust",
        "liblog_rust",
        "libsdv_log_rust",
    ],

    require_root: true,
}

rust_test {
    name: "sdv_pstore_test",
    team: "trendy_team_automotive",
    srcs: ["pstore/sdv_pstore_test.rs"],
    defaults: [
        "sdv@rust_defaults",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
    ],
    test_config: "pstore/AndroidTest.xml",
    require_root: true,
}
