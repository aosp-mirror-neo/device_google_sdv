# Copyright 2023 Google LLC
# SDV's primary init .rc file which is loaded first by the init process.

import /system/etc/init/hw/init.sdv.base.rc

on boot
    # Start a shell on the `earlycon` serial port. Allows inspecting the system
    # state when adb fails to start up.
    start console

service init_open_dice /system_ext/bin/init_open_dice
    class core
    disabled
    # logd is not available when init_open_dice is run, so it logs to stdio which is redirected to
    # kmesg
    stdio_to_kmsg
    # TODO: b/340489679 - probably, it should run as system
    user root
    group system
    oneshot
